        android:drawable="@drawable/radio_button_checked_bg" android:color="@color/green_leaf" />

    <!-- Untuk status lainnya, gunakan drawable ini -->
    <item android:drawable="@drawable/radio_button_default_bg" android:color="@color/txt_secondary" />

</selector>