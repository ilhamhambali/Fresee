<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context=".ui.main.history.HistoryFragment">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semua Status"
                app:chipIcon="@drawable/arrow_down"
                app:chipIconVisible="true"
                app:iconEndPadding="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_product"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semua Produk"
                app:chipIcon="@drawable/arrow_down"
                app:chipIconVisible="true"
                app:iconEndPadding="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_date"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semua Tanggal"
                app:chipIcon="@drawable/arrow_down"
                app:chipIconVisible="true"
                app:iconEndPadding="0dp"/>

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>


    <!-- RecyclerView for history Products -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        tools:listitem="@layout/item_history" />
</FrameLayout>
